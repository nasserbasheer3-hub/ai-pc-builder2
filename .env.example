# ============================================================
#  Gaming Performance Platform - Backend Environment
#  Copy this file to backend/.env and fill in your values.
#  NEVER commit real secrets. NEVER reference these in frontend.
# ============================================================

# --- Server ---
PORT=3001
NODE_ENV=development
# Public base URL used in verification/reset links (dev mode uses the frontend URL)
APP_URL=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-string
JWT_ADMIN_SECRET=change-me-to-a-different-long-random-string
CORS_ORIGIN=http://localhost:5173

# --- Database ---
# Path to the SQLite database file (created automatically)
DATABASE_PATH=./data/gaming_platform.db

# --- Email (SMTP) ---
# Leave empty to use the built-in development "mailbox" that prints
# verification/reset links to the server console and exposes debug links
# in API responses (development only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Gaming Performance Platform <no-reply@gamingplatform.local>"

# --- AI Service (configured here, read ONLY by the backend) ---
# The platform never exposes these to the frontend. Leave blank to run
# in offline mode: analysis engines still work, AI features return a
# clear "AI service temporarily unavailable" message.
USER_LLM_API_KEY=
USER_LLM_BASE_URL=https://api.openai.com/v1
USER_LLM_MODEL=gpt-4o-mini

# --- Admin bootstrap ---
# Created on first seed if it does not exist yet.
ADMIN_EMAIL=admin@gamingplatform.local
ADMIN_PASSWORD=Admin12345!
